# PostgreSQL: keep the password values identical in both lines.
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://wallex_gold:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/wallex_gold

BOT_INSTANCE_ID=vps-main
BOT_VERSION=v5-deploy-ready
LOG_LEVEL=INFO
CONFIG_DIR=./config

# Bale notifications are required by default. Set false only for maintenance.
BALE_ENABLED=true
BALE_BOT_TOKEN=CHANGE_ME
BALE_CHAT_ID=CHANGE_ME
BALE_BASE_URL=https://tapi.bale.ai
BALE_REQUEST_TIMEOUT_SECONDS=15
BALE_MAX_DOCUMENT_BYTES=50000000

# Telegram notifications through andro-cfw.
# Keep false until Telegram integration has been tested end-to-end.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME
TELEGRAM_REQUEST_TIMEOUT_SECONDS=15

# Live Strategy A on Karamad. Paper bot ignores these.
# Keep DRY_RUN true until a login/form fill has been verified.
KARAMAD_LIVE_ENABLED=true
KARAMAD_DRY_RUN=true
KARAMAD_USERNAME=CHANGE_ME
KARAMAD_PASSWORD=CHANGE_ME
KARAMAD_CONFIRM_SECONDS=2
KARAMAD_HEADLESS=false
CHROMEDRIVER=/usr/local/bin/chromedriver
